{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.cliniccorp.desktop",
  "productName": "Smart Clinic",
  "copyright": "Copyright © 2026 ClinicCorp AI. All rights reserved.",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/clinic-app/browser/**/*",
    "desktop/dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "desktop/dist/main.js"
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "SmartClinic-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Smart Clinic"
  },
  "mac": {
    "category": "public.app-category.medical-software",
    "target": [
      {
        "target": "dmg",
        "arch": ["universal", "x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["universal"]
      }
    ],
    "artifactName": "SmartClinic-${version}-mac-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "category": "MedicalSoftware",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "artifactName": "SmartClinic-${version}-${arch}.${ext}"
  }
}
